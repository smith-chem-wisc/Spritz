# Apptainer definition for verifying the bacterial support on a cluster, built from a branch rather
# than a published image so the fixes can be checked before they are merged.
#
# Self-contained on purpose: stage one brings its own .NET SDK and clones the branch, so the cluster
# needs neither dotnet nor Docker. Build with:
#
#     apptainer build --fakeroot spritz.sif spritz.def
#
# It must be built on x86_64. bioconda publishes gatk4 for linux-64 only, with no linux-aarch64, so
# the variants environment will not solve on an ARM machine at all.

Bootstrap: docker
From: mcr.microsoft.com/dotnet/sdk:10.0
Stage: build

%post
    set -eu
    apt-get update && apt-get install -y --no-install-recommends git ca-certificates
    cd /src
    # Pinned by commit, not by branch name, so a rebuild months later is the same build.
    git clone https://github.com/smith-chem-wisc/Spritz.git repo
    cd repo && git checkout "${SPRITZ_COMMIT:-vcf-entry-point}"
    dotnet restore Spritz/SpritzCMD/SpritzCMD.csproj
    dotnet build --no-restore --configuration Release Spritz/SpritzCMD/SpritzCMD.csproj
    git -C /src/repo rev-parse HEAD > /src/repo/COMMIT

%setup
    mkdir -p ${APPTAINER_ROOTFS}/src


Bootstrap: docker
From: mambaorg/micromamba:2.9.0-ubuntu24.04
Stage: final

%files from build
    /src/repo/Spritz/SpritzCMD/bin/Release/net10.0/ /app/spritz/
    /src/repo/COMMIT /app/spritz/COMMIT

%post
    set -eu
    # Set explicitly: %post runs as root and cannot be assumed to have the base image's ENV, and
    # micromamba defaults to ~/micromamba, which would put the whole environment somewhere nothing
    # later looks for it.
    export MAMBA_ROOT_PREFIX=/opt/conda
    micromamba install -y -n base -f /app/spritz/workflow/envs/spritzbase.yaml
    micromamba clean --all --yes
    test -x /opt/conda/bin/conda || { echo "conda did not land in /opt/conda"; exit 1; }

%environment
    # The base image's PATH does NOT include /opt/conda/bin - it relies on its Docker ENTRYPOINT
    # (_entrypoint.sh) to activate the base environment. Apptainer runs %runscript instead of that
    # entrypoint, so without this `conda` is not on PATH and every invocation dies with
    # "exec: conda: not found". The published image escapes this only because it has no custom
    # runscript, so Apptainer's conversion execs the Docker entrypoint for it.
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/bin:$PATH
    export LC_ALL=C

%runscript
    # A plain exec, so the caller passes the same `conda run ... dotnet SpritzCMD.dll` that the
    # Docker and Apptainer CI jobs use. One invocation form across all runtimes.
    exec "$@"

%test
    # Fails the build rather than the run. Every one of these was a way the first version of this
    # definition broke silently and only surfaced on the cluster.
    set -eu
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/bin:$PATH
    echo "commit:    $(cat /app/spritz/COMMIT)"
    command -v conda      >/dev/null || { echo "FAIL: conda not on PATH"; exit 1; }
    command -v snakemake  >/dev/null || { echo "FAIL: snakemake missing"; exit 1; }
    command -v dotnet     >/dev/null || { echo "FAIL: dotnet missing"; exit 1; }
    test -f /app/spritz/SpritzCMD.dll || { echo "FAIL: SpritzCMD.dll missing"; exit 1; }
    test -f /app/spritz/workflow/Snakefile || { echo "FAIL: workflow not packaged"; exit 1; }
    test -f /app/spritz/workflow/scripts/spritz_config.py || { echo "FAIL: scripts not packaged"; exit 1; }
    cd /app/spritz && conda run --no-capture-output dotnet SpritzCMD.dll --help >/dev/null \
        || { echo "FAIL: SpritzCMD --help did not run"; exit 1; }
    echo "all container checks passed"

%labels
    Description Spritz, built from a branch for bacterial verification
