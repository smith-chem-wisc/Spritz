# Apptainer definition for verifying the bacterial support on a cluster, built from a branch rather
# than a published image so the fixes can be checked before they are merged.
#
# This does NOT compile anything. build.sh compiles SpritzCMD first, in a plain `apptainer exec` of
# the .NET SDK image, and this definition only copies the result in and installs the conda base
# environment. The compile used to happen in %post, which runs under `--fakeroot`, and it failed
# there with
#   CSC : error CS2001: Source file '.../SpritzBackend.GeneratedMSBuildEditorConfig.editorconfig' could not be found
# on a file the SDK generates during build. That did not reproduce outside fakeroot, so rather than
# guess at the interaction, the compile was moved out of the privileged build entirely. It also makes
# iterating on this file fast, since a rebuild no longer recompiles.
#
# Must be built on x86_64: bioconda publishes gatk4 for linux-64 only, with no linux-aarch64, so the
# variants environment will not solve on an ARM machine at all.
#
#     ./build.sh

# localimage, not docker://. build.sh pulls the base to micromamba-base.sif first, because
# converting an OCI image to SIF tolerates a filesystem that cannot store extended attributes while
# the rootless layer unpack `apptainer build` performs does not - which is how this failed with
# `unpriv.lsetxattr: invalid argument` on a shared HPC filesystem.
Bootstrap: localimage
From: micromamba-base.sif

%files
    # Explicit source and destination, with no trailing slashes. `%files` copies with `cp -rfL`, and
    # GNU cp treats `build/app/ /app/` as "put the directory app inside /app", giving
    # /app/app/spritz/... - which is why the base environment install could not find its YAML. BSD
    # cp copies the contents instead, so this does not reproduce on macOS.
    build/app/spritz /app/spritz

%post
    set -eu
    # Say where things actually are if the copy above ever lands them somewhere else, rather than
    # leaving micromamba to report a missing file and nothing about why.
    if [ ! -f /app/spritz/workflow/envs/spritzbase.yaml ]; then
        echo "ERROR: expected /app/spritz/workflow/envs/spritzbase.yaml. Found instead:"
        find /app -maxdepth 4 -name 'spritzbase.yaml' -o -maxdepth 2 -type d | sed 's/^/  /'
        exit 1
    fi

    # Set explicitly: %post runs as root and cannot be assumed to have the base image's ENV, and
    # micromamba defaults to ~/micromamba, which would put the whole environment somewhere nothing
    # later looks for it.
    export MAMBA_ROOT_PREFIX=/opt/conda
    micromamba install -y -n base -f /app/spritz/workflow/envs/spritzbase.yaml
    micromamba clean --all --yes
    test -x /opt/conda/bin/conda || { echo "conda did not land in /opt/conda"; exit 1; }

%environment
    # The base image's PATH does NOT include /opt/conda/bin - it relies on its Docker ENTRYPOINT
    # (_entrypoint.sh) to activate the base environment. Apptainer runs %runscript instead of that
    # entrypoint, so without this `conda` is not on PATH and every invocation dies with
    # "exec: conda: not found". The published image escapes this only because it has no custom
    # runscript, so Apptainer's conversion execs the entrypoint for it.
    export MAMBA_ROOT_PREFIX=/opt/conda
    export CONDA_PREFIX=/opt/conda
    export PATH=/opt/conda/bin:$PATH

    # Prepending bin/ is not activation, and some packages need the difference. dotnet-runtime ships
    # no bin/dotnet at all - the binary is lib/dotnet/dotnet, put on PATH by
    # etc/conda/activate.d/dotnet-root.sh - so `dotnet` was missing here while working in Docker,
    # whose entrypoint activates. Running the hooks covers that and anything else that does the same.
    if [ -d /opt/conda/etc/conda/activate.d ]; then
        for _spritz_hook in /opt/conda/etc/conda/activate.d/*.sh; do
            [ -r "$_spritz_hook" ] && . "$_spritz_hook"
        done
        unset _spritz_hook
    fi
    export LC_ALL=C

%runscript
    # A plain exec, so the caller passes the same `conda run ... dotnet SpritzCMD.dll` that the
    # Docker and Apptainer CI jobs use. One invocation form across all runtimes.
    exec "$@"

%test
    # Fails the build rather than the run. Every one of these was a way an earlier version of this
    # definition broke silently and only surfaced on the cluster.
    set -eu
    # %environment is applied to %test, so this checks what a real invocation will see rather than
    # re-deriving it. Failures print where things actually are, because "dotnet missing" on its own
    # sent me looking in the wrong place.
    echo "commit:    $(cat /app/spritz/COMMIT)"
    command -v conda      >/dev/null || { echo "FAIL: conda not on PATH"; exit 1; }
    command -v snakemake  >/dev/null || { echo "FAIL: snakemake missing"; exit 1; }
    if ! command -v dotnet >/dev/null; then
        echo "FAIL: dotnet not on PATH. DOTNET_ROOT=${DOTNET_ROOT:-unset}"
        echo "      activation hooks present:"; ls /opt/conda/etc/conda/activate.d/ 2>&1 | sed 's/^/        /'
        echo "      dotnet binaries found:"; ls /opt/conda/lib/dotnet/dotnet 2>&1 | sed 's/^/        /'
        exit 1
    fi
    echo "dotnet:    $(dotnet --version 2>&1 | head -1) at $(command -v dotnet)"
    test -f /app/spritz/SpritzCMD.dll || { echo "FAIL: SpritzCMD.dll missing"; exit 1; }
    test -f /app/spritz/workflow/Snakefile || { echo "FAIL: workflow not packaged"; exit 1; }
    test -f /app/spritz/workflow/scripts/spritz_config.py || { echo "FAIL: scripts not packaged"; exit 1; }
    cd /app/spritz && conda run --no-capture-output dotnet SpritzCMD.dll --help >/dev/null \
        || { echo "FAIL: SpritzCMD --help did not run"; exit 1; }
    echo "all container checks passed"

%labels
    Description Spritz, built from a branch for bacterial verification
