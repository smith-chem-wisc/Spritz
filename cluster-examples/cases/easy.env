# EASY - Pseudomonas aeruginosa PAO1.
# One contig named `Chromosome`, well annotated, and it has its own UniProt reference proteome
# (UP000002438 - the one the reporter of #185 linked). Exercises: Ensembl Bacteria collection
# lookup, the CHECKSUMS filename path (PAO1's DNA file carries the awkward trailing underscore,
# `ASM676v1_.dna.toplevel.fa.gz`), genome-level codon table 11, and bootstrapped known sites.
CASE=easy
SPECIES=Pseudomonas_aeruginosa_pao1_gca_000006765
GENOME=ASM676v1
RELEASE=63
ORGANISM=pseudomonas aeruginosa
# Small RNA-seq run; variants are bootstrapped from it since Ensembl Bacteria publishes no sites.
# Verified present in ENA: taxid 208964, RNA-Seq, paired, ~11.2M reads.
SRA=DRR763891
EXPECT_CONTIG=Chromosome
EXPECT_CODON_TABLE=Bacterial_and_Plant_Plastid
