# HARD - Mycoplasma, which does not use the bacterial codon table.
# Mollicutes use NCBI table 4, where TGA is tryptophan rather than a stop. Against table 11 that is
# the single difference that matters, and it is not a nuance: translating this genome with table 11
# truncates every protein at its first TGA.
#
# This is the case that verifies the fix, and it is checkable without any proteomics - compare the
# protein lengths SnpEff emits against the pep.all.fa Ensembl ships for the same genome. If they
# disagree, the codon table is wrong.
CASE=hard
SPECIES=Mycoplasma_hyopneumoniae_232_gca_000008405
GENOME=ASM840v1
RELEASE=63
ORGANISM=mycoplasma hyopneumoniae
SRA=
EXPECT_CONTIG=
EXPECT_CODON_TABLE=Mycoplasma
