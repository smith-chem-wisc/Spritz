# VCF - PAO1 annotated from a supplied VCF rather than from reads.
# Generated locally by make_test_vcf.sh against the reference's own contig, so it needs no download
# and no calling, and it runs in minutes. Exercises the entry point end to end: stage_user_vcf, the
# contig-name guard, the AD guard, the sites-only guard, and variant_annotation_ref.
CASE=vcf
SPECIES=Pseudomonas_aeruginosa_pao1_gca_000006765
GENOME=ASM676v1
RELEASE=63
ORGANISM="pseudomonas aeruginosa"
SRA=
VCF=pao1_test.vcf
EXPECT_CONTIG=Chromosome
EXPECT_CODON_TABLE=Bacterial_and_Plant_Plastid
