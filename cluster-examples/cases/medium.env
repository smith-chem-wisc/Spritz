# MEDIUM - an assembly whose name contains spaces.
# `IMG-taxon 2667527408 annotated assembly`. 2,217 of Ensembl Bacteria's 31,332 assemblies contain a
# space and 1,580 contain a '#', and Ensembl rewrites those into filenames by collapsing unsafe runs
# to '_'. This is the case that breaks a naive URL template, and the reason filenames are read from
# each directory's CHECKSUMS index instead of being constructed.
#
# Also checks that the sanitised name is what reaches REF, and so the local paths and the SnpEff
# genome name.
CASE=medium
SPECIES=Acetanaerobacterium_elongatum_gca_900103835
GENOME=IMG-taxon_2667527408_annotated_assembly
RELEASE=63
ORGANISM=acetanaerobacterium elongatum
SRA=
EXPECT_CONTIG=
EXPECT_CODON_TABLE=Bacterial_and_Plant_Plastid
